CIDADES = [
    "Caicó RN",
    "Natal RN",
    "Mossoró RN",
    "João Pessoa PB",
    "Recife PE",
    "São Fernando RN",
    "Timbaúba dos Batistas RN",
    "São José do Seridó RN",
    "Cruzeta RN",
    "Jardim do Seridó RN",
    "São João do Sabugi RN",
    "Serra Negra do Norte RN",
    "Jucurutu RN",
    "Florânia RN",
    "Ouro Branco RN",
    "Várzea PB",
]


def gerar_links(produto, marca, preco_maximo, cidades):
    termo_produto = " ".join(
        parte for parte in [produto, marca] if parte
    ).strip()

    preco_centavos = int(preco_maximo * 100)
    links = []

    # Lojas nas quais a localização regional é útil
    for cidade in cidades:
        termo_local = f"{termo_produto} {cidade}"

        links.extend([
            {
                "loja": "Mercado Livre",
                "cidade": cidade,
                "url": (
                    "https://lista.mercadolivre.com.br/"
                    f"{quote(termo_local.replace(' ', '-'))}"
                    f"_PriceRange_0-{int(preco_maximo)}"
                ),
            },
            {
                "loja": "OLX",
                "cidade": cidade,
                "url": (
                    "https://www.olx.com.br/brasil"
                    f"?q={quote_plus(termo_local)}"
                    f"&pe={int(preco_maximo)}"
                ),
            },
        ])

    # Lojas nacionais
    links_nacionais = [
        {
            "loja": "Amazon",
            "url": (
                "https://www.amazon.com.br/s"
                f"?k={quote_plus(termo_produto)}"
                f"&rh=p_36%3A0-{preco_centavos}"
            ),
        },
        {
            "loja": "Magazine Luiza",
            "url": (
                "https://www.magazineluiza.com.br/busca/"
                f"{quote(termo_produto.replace(' ', '-'))}/"
            ),
        },
        {
            "loja": "Casas Bahia",
            "url": (
                "https://www.casasbahia.com.br/busca/"
                f"{quote(termo_produto.replace(' ', '-'))}/"
            ),
        },
        {
            "loja": "KaBuM!",
            "url": (
                "https://www.kabum.com.br/busca/"
                f"{quote(termo_produto.replace(' ', '-'))}"
            ),
        },
        {
            "loja": "AliExpress",
            "url": (
                "https://www.aliexpress.com/wholesale"
                f"?SearchText={quote_plus(termo_produto)}"
            ),
        },
        {
            "loja": "Americanas",
            "url": (
                "https://www.americanas.com.br/busca/"
                f"{quote(termo_produto.replace(' ', '-'))}"
            ),
        },
        {
            "loja": "Shopee",
            "url": (
                "https://shopee.com.br/search"
                f"?keyword={quote_plus(termo_produto)}"
            ),
        },
        {
            "loja": "Pichau",
            "url": (
                "https://www.pichau.com.br/search"
                f"?q={quote_plus(termo_produto)}"
            ),
        },
        {
            "loja": "Carrefour",
            "url": (
                "https://www.carrefour.com.br/busca/"
                f"{quote(termo_produto.replace(' ', '-'))}"
            ),
        },
    ]

    for item in links_nacionais:
        item["cidade"] = "Loja nacional"
        links.append(item)

    return links


def classificar_links(produto, links):
    produto = produto.lower()

    if any(p in produto for p in [
        "celular", "notebook", "computador", "hardware",
        "placa", "mouse", "teclado", "monitor"
    ]):
        prioridade = ["KaBuM!", "Pichau", "Amazon", "Mercado Livre"]

    elif "livro" in produto:
        prioridade = ["Amazon", "Americanas", "Mercado Livre"]

    elif any(p in produto for p in [
        "geladeira", "fogão", "micro-ondas",
        "microondas", "tv", "eletrodoméstico"
    ]):
        prioridade = [
            "Carrefour",
            "Casas Bahia",
            "Magazine Luiza",
            "Mercado Livre",
        ]

    else:
        prioridade = [
            "Mercado Livre",
            "Shopee",
            "Amazon",
            "OLX",
            "AliExpress",
        ]

    ordem = {loja: indice for indice, loja in enumerate(prioridade)}

    return sorted(
        links,
        key=lambda item: ordem.get(item["loja"], len(prioridade))
    )


def criar_relatorio(produto, marca, preco, links):
    linhas = []

    for item in links:
        linhas.append(
            f"""
        <a href="{item['url']}" class="loja" target="_blank" rel="noopener noreferrer">
            <strong>{item['loja']}</strong>
            <span>{item['cidade']}</span>
            <small>Abrir pesquisa ↗</small>
        </a>
        """
        )

    preco_formatado = f"{preco:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")

    html = f"""<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pesquisa de produtos</title>

<style>
body {{
    margin: 0;
    padding: 30px;
    background: #f3f5f8;
    color: #243040;
    font-family: Arial, sans-serif;
}}

.container {{
    max-width: 850px;
    margin: auto;
}}

.cabecalho {{
    padding: 25px;
    margin-bottom: 20px;
    color: white;
    background: #1769e0;
    border-radius: 16px;
}}

.cabecalho h1 {{
    margin-top: 0;
}}

.resumo {{
    padding: 18px;
    margin-bottom: 20px;
    background: white;
    border-radius: 12px;
}}

.lojas {{
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(220px, 1fr)
    );
    gap: 12px;
}}

.loja {{
    display: flex;
    flex-direction: column;
    gap: 8px;
