</style>
</head>

<body>
<main class="container">
<section class="cabecalho">
    <h1>🔎 Pesquisa de produtos</h1>
    <p>Escolha uma loja para visualizar os resultados.</p>
</section>

<section class="resumo">
    <strong>Produto:</strong> {produto}<br>
    <strong>Marca:</strong> {marca or "Qualquer marca"}<br>
    <strong>Preço máximo:</strong> R$ {preco_formatado}
</section>

<section class="lojas">
{''.join(linhas)}
</section>
</main>
</body>
</html>
"""

    arquivo = Path("resultados_busca.html").resolve()
    arquivo.write_text(html, encoding="utf-8")

    return arquivo


# --- INTERFACE GRÁFICA (GUI) ---
def iniciar_interface():
    janela = tk.Tk()
    janela.title("🔎 Buscador de Produtos")
    janela.geometry("450x520")
    janela.resizable(False, False)

    # Estilo dos componentes
    style = ttk.Style()
    style.theme_use("clam")

    container = ttk.Frame(janela, padding="25")
    container.pack(fill=tk.BOTH, expand=True)

    # Título da Interface
    titulo = ttk.Label(
        container,
        text="🔎 Buscador de Produtos",
        font=("Segoe UI", 16, "bold"),
        foreground="#1769e0",
    )
    titulo.pack(anchor="w", pady=(0, 5))

    subtitulo = ttk.Label(
        container,
        text="Preencha os filtros abaixo para buscar nas lojas:",
        font=("Segoe UI", 9),
        foreground="#555555",
    )
    subtitulo.pack(anchor="w", pady=(0, 20))

    # Campo 1: Produto
    ttk.Label(container, text="📦 Produto *", font=("Segoe UI", 10, "bold")).pack(anchor="w")
    ent_produto = ttk.Entry(container, font=("Segoe UI", 10))
    ent_produto.pack(fill=tk.X, pady=(3, 12))
    ent_produto.focus()

    # Campo 2: Marca
    ttk.Label(container, text="🏷️ Marca (opcional)", font=("Segoe UI", 10, "bold")).pack(anchor="w")
    ent_marca = ttk.Entry(container, font=("Segoe UI", 10))
    ent_marca.pack(fill=tk.X, pady=(3, 12))

    # Campo 3: Preço
    ttk.Label(container, text="💰 Preço Máximo (R$) *", font=("Segoe UI", 10, "bold")).pack(anchor="w")
    ent_preco = ttk.Entry(container, font=("Segoe UI", 10))
    ent_preco.pack(fill=tk.X, pady=(3, 12))

    # Campo 4: Cidade
    ttk.Label(container, text="📍 Cidade da Busca *", font=("Segoe UI", 10, "bold")).pack(anchor="w")
    opcoes_cidade = ["Todas as Cidades"] + CIDADES
    combo_cidade = ttk.Combobox(
        container, values=opcoes_cidade, state="readonly", font=("Segoe UI", 10)
    )
    combo_cidade.current(0)
    combo_cidade.pack(fill=tk.X, pady=(3, 22))

    # Ação do Botão
    def ao_clicar_buscar():
        produto = ent_produto.get().strip()
        marca = ent_marca.get().strip()
        preco_raw = ent_preco.get().strip().replace(".", "").replace(",", ".")
        cidade_selecionada = combo_cidade.get()

        if not produto:
            messagebox.showwarning("Aviso", "Por favor, digite o nome do produto.")
            ent_produto.focus()
            return

        if not preco_raw:
            messagebox.showwarning("Aviso", "Por favor, informe o preço máximo.")
            ent_preco.focus()
            return

        try:
            preco = float(preco_raw)
            if preco <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror(
                "Erro no Preço",
                "Digite um valor válido para o preço.\nExemplo: 1500 ou 1500,50",
            )
            ent_preco.focus()
            return

        if cidade_selecionada == "Todas as Cidades":
            cidades_busca = CIDADES.copy()
        else:
            cidades_busca = [cidade_selecionada]

        # Processa e gera o relatório
        links = gerar_links(produto, marca, preco, cidades_busca)
        links = classificar_links(produto, links)
        relatorio = criar_relatorio(produto, marca, preco, links)

        # Abre no navegador
        webbrowser.open(relatorio.as_uri())

        messagebox.showinfo(
            "Sucesso!",
            f"Relatório gerado com {len(links)} pesquisas!\nO resultado foi aberto no seu navegador.",
        )

    # Botão de Executar
    btn_buscar = tk.Button(
        container,
        text="🚀 Gerar Pesquisa",
        font=("Segoe UI", 11, "bold"),
        bg="#1769e0",
        fg="white",
        activebackground="#1151b3",
        activeforeground="white",
        relief="flat",
        cursor="hand2",
        command=ao_clicar_buscar,
    )
    btn_buscar.pack(fill=tk.X, ipady=8)

    janela.mainloop()


if __name__ == "__main__":
    iniciar_interface()
